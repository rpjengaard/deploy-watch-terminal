{
  "name": "deploy-watch-terminal",
  "version": "0.2.0",
  "description": "Terminal UI to watch Azure DevOps pipelines & releases live, with approvals",
  "license": "MIT",
  "author": "René Pjengaard Bank",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpjengaard/deploy-watch-terminal.git"
  },
  "homepage": "https://github.com/rpjengaard/deploy-watch-terminal#readme",
  "keywords": [
    "azure-devops",
    "pipelines",
    "releases",
    "tui",
    "ink",
    "bun",
    "deploy"
  ],
  "type": "module",
  "bin": {
    "deploy-watch": "./src/cli.tsx"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/cli.tsx",
    "mock": "bun run src/cli.tsx --mock",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify --outfile dist/deploy-watch src/cli.tsx",
    "build:all": "bun run build:mac-arm && bun run build:mac-x64 && bun run build:linux",
    "build:mac-arm": "bun build --compile --minify --target=bun-darwin-arm64 --outfile dist/deploy-watch-darwin-arm64 src/cli.tsx",
    "build:mac-x64": "bun build --compile --minify --target=bun-darwin-x64 --outfile dist/deploy-watch-darwin-x64 src/cli.tsx",
    "build:linux": "bun build --compile --minify --target=bun-linux-x64 --outfile dist/deploy-watch-linux-x64 src/cli.tsx"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "react-devtools-core": "^7.0.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
}
